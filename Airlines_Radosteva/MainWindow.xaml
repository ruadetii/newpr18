<Window x:Class="Airlines_Radosteva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Airlines_Radosteva"
        mc:Ignorable="d"
        Title="Управление авиалиниями" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <Grid Height="60" VerticalAlignment="Top" Background="#FF0C73FF">
            <Image Source="/Images/plane.png" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,5,5,5"/>
            <Label VerticalAlignment="Top" HorizontalAlignment="Left" Content="Управление авиалиниями" Foreground="White" FontSize="16" FontWeight="bold" Margin="60,10,0,0"/>
            <Button Click="Exit" VerticalAlignment="Top" HorizontalAlignment="Right" Width="100" Height="25" Content="Выйти" Background="White" BorderBrush="White" Margin="0,10,10,0"/>
        </Grid>
        <Frame x:Name="frame" NavigationUIVisibility="Hidden" Margin="0,60,0,0"/>
    </Grid>
</Window>
