<UserControl x:Class="Airlines_Radosteva.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Airlines_Radosteva.Elements"
             mc:Ignorable="d">
    <Grid Background="#E4E4E4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lPrice" Content="1999 Р" VerticalAlignment="Top" Margin="10,10,10,0" FontSize="20" HorizontalContentAlignment="Center"/>
        <Button Content="Подробнее" Height="25" Margin="10,52,10,0" VerticalAlignment="Top" Background="#FF4000" BorderBrush="#FF4000" Foreground="White"/>

        <Label Content="Победа" Grid.Column="1" VerticalAlignment="Top" Margin="10,10,10,0" HorizontalContentAlignment="Center"/>
        <Label x:Name="fromTime" Content="05:00" Grid.Column="1" VerticalAlignment="Top" Margin="10,36,10,0" FontSize="16" HorizontalContentAlignment="Center"/>
        <Label x:Name="fromDate" Content="09.12.2023" Grid.Column="1" VerticalAlignment="Top" Margin="10,68,10,0" HorizontalContentAlignment="Center"/>
        <Label x:Name="from" Content="Пермь" Grid.Column="1" VerticalAlignment="Top" Margin="10,94,10,0" HorizontalContentAlignment="Center"/>

        <Image Source="/Images/plane.png" Grid.Column="2" HorizontalAlignment="Left" Height="30" Margin="10,35,0,0" VerticalAlignment="Top" Width="30"/>
        <Label x:Name="way" Content="в пути 2 часа 55 минут" Grid.Column="2" Margin="44,35,34,0" VerticalAlignment="Top" HorizontalContentAlignment="Center"/>
        <Grid Grid.Column="2" Background="#939393" Height="5" VerticalAlignment="Top" Margin="5,72,5,0"/>
        <Image Source="/Images/plane.png" Grid.Column="2" HorizontalAlignment="Right" Height="30" Margin="0,35,10,0" VerticalAlignment="Top" Width="30" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Label Content="Победа" Grid.Column="3" VerticalAlignment="Top" Margin="10,10,10,0" HorizontalContentAlignment="Center"/>
        <Label x:Name="toTime" Content="05:00" Grid.Column="3" VerticalAlignment="Top" Margin="10,36,10,0" FontSize="16" HorizontalContentAlignment="Center"/>
        <Label x:Name="toDate" Content="09.12.2023" Grid.Column="3" VerticalAlignment="Top" Margin="10,68,10,0" HorizontalContentAlignment="Center"/>
        <Label x:Name="to" Content="Пермь" Grid.Column="3" VerticalAlignment="Top" Margin="10,94,10,0" HorizontalContentAlignment="Center"/>
    </Grid>
</UserControl>
